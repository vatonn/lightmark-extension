{
  "manifest_version": 3,
  "name": "轻收藏",
  "version": "1.3.0",
  "description": "更轻快的收藏夹：快速搜索、文件夹浏览、多视图管理，以及重复项与空文件夹清理。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "轻收藏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "clipboardWrite"
  ]
}
